    "panels": [
        {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "description": "Prometheus scrape success for lms-backend job. Red = scrape failing / backend unreachable.",
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": { "color": "dark-red", "index": 0, "text": "DOWN" },
                                "1": { "color": "green",    "index": 1, "text": "UP"   }
                            }
                        },
                        {
                            "type": "special",
                            "options": { "match": "null", "result": { "color": "orange", "text": "UNKNOWN" } }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "dark-red", "value": null },
                            { "color": "green", "value": 1 }
                        ]
                    }
                }
            },
            "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
            "id": 12,
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "auto",
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "textMode": "auto"
            },
            "pluginVersion": "9.0.0",
            "targets": [
                {
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "up{job=\"lms-backend\"}",
                    "instant": true,
                    "refId": "A"
                }
            ],
            "title": "Backend Status",
            "type": "stat"
        },
        {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
