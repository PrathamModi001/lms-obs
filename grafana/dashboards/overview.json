                            { "color": "yellow", "value": 500  },
                            { "color": "red",    "value": 2000 }
                        ]
                    },
                    "unit": "ms"
                }
            },
            "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
            "id": 2,
            "options": {
                "colorMode": "value",
