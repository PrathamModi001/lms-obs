{
    "annotations": {
        "list": [
            {
                "builtIn": 1,
                "datasource": { "uid": "-- Grafana --" },
                "enable": true,
                "hide": true,
                "iconColor": "rgba(0, 211, 255, 1)",
                "name": "Annotations & Alerts",
                "type": "dashboard"
            }
        ]
    },
    "description": "One-stop disaster triage: firing alerts, error source breakdown, exact log lines with stack traces, deletion audit.",
    "editable": true,
    "gnetId": null,
    "graphTooltip": 1,
    "id": null,
    "links": [
        {
            "icon": "dashboard",
            "targetBlank": false,
            "title": "System Overview",
            "tooltip": "Back to Overview",
            "type": "link",
            "url": "/d/lms-overview"
        },
        {
            "icon": "chart-bar",
            "targetBlank": false,
            "title": "Full Analytics",
            "tooltip": "Deep-dive performance dashboard",
            "type": "link",
            "url": "/d/lms-website-analytics-complete"
        }
    ],
    "panels": [

        {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "description": "Prometheus scrape success. Red = backend unreachable.",
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": { "color": "dark-red", "index": 0, "text": "DOWN" },
                                "1": { "color": "green",    "index": 1, "text": "UP"   }
                            }
                        },
                        {
                            "type": "special",
                            "options": { "match": "null", "result": { "color": "orange", "text": "UNKNOWN" } }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "dark-red", "value": null },
                            { "color": "green",    "value": 1    }
                        ]
                    }
                }
            },
            "gridPos": { "h": 3, "w": 3, "x": 0, "y": 0 },
            "id": 1,
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "auto",
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "textMode": "auto"
            },
            "pluginVersion": "9.0.0",
            "targets": [
                {
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "up{job=\"lms-backend\"}",
                    "instant": true,
                    "refId": "A"
                }
            ],
            "title": "Backend Status",
            "type": "stat"
        },

        {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "description": "Fatal events (uncaughtException, unhandledRejection) in last 15 minutes. Any value > 0 = process nearly crashed.",
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green",   "value": null },
                            { "color": "dark-red","value": 1    }
                        ]
                    }
                }
            },
            "gridPos": { "h": 3, "w": 3, "x": 3, "y": 0 },
            "id": 2,
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "auto",
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "textMode": "auto"
            },
            "pluginVersion": "9.0.0",
            "targets": [
                {
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "round(sum(increase(app_errors_total{severity=\"fatal\"}[$__range]))) OR vector(0)",
                    "refId": "A"
                }
            ],
            "title": "Fatal Events",
            "type": "stat"
        },

        {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "description": "Server-side errors (5xx, DB failures, unexpected throws) in last 15 minutes.",
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green",  "value": null },
                            { "color": "yellow", "value": 1    },
                            { "color": "red",    "value": 10   }
                        ]
                    }
                }
            },
            "gridPos": { "h": 3, "w": 3, "x": 6, "y": 0 },
            "id": 3,
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "auto",
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "textMode": "auto"
            },
            "pluginVersion": "9.0.0",
            "targets": [
                {
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "round(sum(increase(app_errors_total{severity=\"error\"}[$__range]))) OR vector(0)",
                    "refId": "A"
                }
            ],
            "title": "Errors",
            "type": "stat"
        },

        {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green",  "value": null },
                            { "color": "yellow", "value": 0.01 },
                            { "color": "red",    "value": 0.05 }
                        ]
                    },
                    "unit": "percentunit"
                }
            },
            "gridPos": { "h": 3, "w": 3, "x": 9, "y": 0 },
            "id": 4,
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "textMode": "auto"
            },
            "pluginVersion": "9.0.0",
            "targets": [
                {
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "(sum(increase(http_server_request_duration_count{http_status_code=~\"5..\"}[$__range])) / sum(increase(http_server_request_duration_count[$__range]))) OR vector(0)",
                    "refId": "A"
                }
            ],
            "title": "5xx Rate",
            "type": "stat"
        },

        {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green",  "value": null },
                            { "color": "yellow", "value": 500  },
                            { "color": "red",    "value": 2000 }
                        ]
                    },
                    "unit": "ms"
                }
            },
            "gridPos": { "h": 3, "w": 3, "x": 12, "y": 0 },
            "id": 5,
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "textMode": "auto"
            },
            "pluginVersion": "9.0.0",
            "targets": [
                {
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_bucket[$__rate_interval])) by (le))",
                    "refId": "A"
                }
            ],
            "title": "P95 Latency",
            "type": "stat"
        },

        {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "description": ">500ms means the Node.js process is blocking the event loop — all requests stall.",
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green",  "value": null },
                            { "color": "yellow", "value": 100  },
                            { "color": "red",    "value": 500  }
                        ]
                    },
                    "unit": "ms"
                }
            },
            "gridPos": { "h": 3, "w": 3, "x": 15, "y": 0 },
            "id": 6,
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "textMode": "auto"
            },
            "pluginVersion": "9.0.0",
            "targets": [
                {
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "histogram_quantile(0.95, sum(rate(nodejs_event_loop_lag_ms_bucket[$__rate_interval])) by (le))",
                    "refId": "A"
                }
            ],
            "title": "Event Loop Lag (P95)",
            "type": "stat"
        },

        {
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "mappings": [],
